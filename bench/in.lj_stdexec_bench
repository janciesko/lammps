# 3d LJ melt for benchmarking the Kokkos Verlet integrator.
# The same input is used for the original and the kokkos-stdexec build.
#
#   -var n     number of fcc unit cells per dimension (atoms = 4*n^3)
#   -var steps timed steps
#   -var warm  untimed warm-up steps (kernel setup, allocations, first neighbor build)
#
# bench_stdexec.sh sets these. Run by hand:
#   lmp -k on g 1 -sf kk -var n 20 -var steps 1000 -in bench/in.lj_stdexec_bench

variable        n     index 20
variable        steps index 1000
variable        warm  index 100

units           lj
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 $n 0 $n 0 $n
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create 1.44 87287 loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    delay 0 every 20 check no

fix             1 all nve

# only print at the end of each run so output does not perturb the timing
thermo          ${steps}

# untimed warm-up, bench.sh parses the Loop time of the second run
run             ${warm}
run             ${steps}
